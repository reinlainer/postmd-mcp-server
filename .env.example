# Everything here is optional. With no configuration at all, the server talks to
# production and can publish and read documents anonymously.

# Where PostMD runs. Defaults to https://postmd.turink.com — set this only for a
# self-hosted or local instance. Origin only, no trailing slash.
#POSTMD_BASE_URL=http://localhost:8080

# Needed for managing documents (update/delete), attachments and groups.
# A signed-in member creates keys at https://postmd.turink.com/account —
# pick the scopes your tools need (read and write are independent).
#POSTMD_API_KEY=pmk_your_key_here

# 1 / true / yes → verbose diagnostics on stderr.
#POSTMD_DEBUG=1
